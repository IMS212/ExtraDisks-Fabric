{
  "schemaVersion": 1,
  "id": "extradisks",
  "version": "${version}",
  "name": "Extra Disks (Unofficial Fabric Port)",
  "description": "Extra Disks adds bigger disks to Refined Storage. This is an unofficial port.",
  "authors": [
    "MelanX",
    "IMS212"
  ],
  "icon": "icon.png",
  "contact": {
    "sources": "https://github.com/IMS212/ExtraDisks-Fabric"
  },
  "license": "Apache-2.0",
  "accessWidener" : "extradisks.accesswidener",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "de.melanx.extradisks.data.DataCreator"
    ]
  },
  "mixins": [
    "extradisks.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "forgeconfigapiport": "*",
    "refinedstorage": "*",
    "fabric-api": "*"
  }
}